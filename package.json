{
  "name": "principe-pescatore-landing",
  "version": "2.0.0",
  "private": true,
  "description": "Landing Principe Pescatore v2: mare in WebGL + scroll cinematografico",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=assets/js/main.bundle.js && esbuild src/effects/ocean-scene.js --bundle --minify --format=iife --global-name=PPOcean --target=es2019 --loader:.webp=dataurl --loader:.png=dataurl --outfile=assets/js/ocean.bundle.js",
    "watch": "esbuild src/main.js --bundle --format=iife --outfile=assets/js/main.bundle.js --watch"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
